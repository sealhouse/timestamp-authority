# Read by ci/hack/build-image.sh.
IMAGE=tsa
CONTAINERFILE=.sealhouse/Containerfile
BINARIES=/usr/local/bin/timestamp-server
WRITABLE_PATHS=/tmp
# Arguments for the image test: the container must start and stay up under a random UID.
SMOKE_ARGS="serve --host=0.0.0.0 --port=3000 --disable-ntp-monitoring"
LDFLAGS_PKG=sigs.k8s.io/release-utils/version
